# Local development: a plain SQLite file, no external service needed.
DATABASE_URL="file:./prisma/dev.db"

# Secret used to sign session cookies (JWT). Generate a long random string in production,
# e.g. `openssl rand -base64 48`.
SESSION_SECRET="change-me-in-production-please-use-a-long-random-string"

# Production only: set these to use a free Turso (libSQL) database instead of
# a local file — required on hosts without a persistent filesystem (e.g. the
# Render free tier). Leave both unset for local development.
# TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"
