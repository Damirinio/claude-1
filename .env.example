DATABASE_URL="file:./prisma/dev.db"

# Secret used to sign session cookies (JWT). Generate a long random string in production,
# e.g. `openssl rand -base64 48`.
SESSION_SECRET="change-me-in-production-please-use-a-long-random-string"

# Where uploaded documents are stored on disk. In production, point this at a
# persistent volume (e.g. /data/documents on Railway/Render) so files survive
# redeploys. Defaults to ./storage/documents when unset.
DOCUMENTS_STORAGE_DIR="./storage/documents"
